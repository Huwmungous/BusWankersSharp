<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions match IFGlobal's own (see Infoforum's SampleWebService.csproj) -
         ServiceFactory hands back Swashbuckle SwaggerGenOptions/SwaggerUIOptions
         types directly, so this project's package versions need to line up with
         whatever IFGlobal was built against. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <!-- Sibling checkout assumption: ~/repos/BusWankersSharp and ~/repos/Infoforum
         side by side (matches deploy-buswankers-backend.sh's BW_REPO/IF_REPO
         defaults). -->
    <ProjectReference Include="..\..\Infoforum\csharp\IFGlobal\IFGlobal.csproj" />
  </ItemGroup>

</Project>
