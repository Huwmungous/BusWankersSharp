# Common configuration, read by @if/web-common's EnvironmentConfig (VITE_ prefix
# is Vite's rule for exposing a variable to the browser bundle). These are the
# values AppInitializer validates on start-up: IF_APP_NAME, IF_ENVIRONMENT and
# LOG_LEVEL are required. The config service supplies everything else (Keycloak
# realm/client/authority, the logger service URL) keyed on the AppDomain set in
# src/main.jsx.
#
# Production build values. `npm run dev` overrides them from .env.development.
VITE_IF_APP_NAME=BusWankers
VITE_IF_ENVIRONMENT=PRD
VITE_LOG_LEVEL=Information

# Where the config service lives. Root-relative so it resolves against whatever
# origin the page is served from (holly's nginx publishes it at
# https://longmanrd.net/config). Vite's dev server proxies it - see
# vite.config.js.
VITE_IF_CONFIG_SERVICE_URL=/config
