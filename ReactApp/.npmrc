# Skip npm's automatic peer-dependency resolution for this app (2026-09-29).
#
# On the build host (npm 10.9.8, Node 22) a plain `npm install` dies with
#   TypeError: Cannot read properties of null (reading 'edgesOut')
#   at #loadPeerSet (@npmcli/arborist/lib/arborist/build-ideal-tree.js)
# while resolving vitest 4.1.x's optional peer set (@vitest/browser-playwright,
# @vitejs/devtools-*, happy-dom ...). That is an npm resolver bug, and none of
# those optional peers is needed here. Every peer this app really needs
# (react, react-dom, vite, happy-dom, @testing-library/dom) is a direct
# dependency in package.json instead.
legacy-peer-deps=true
